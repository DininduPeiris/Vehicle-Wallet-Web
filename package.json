{
  "name": "vehicle-wallet-web",
  "homepage": "https://DininduPeiris.github.io/Vehicle-Wallet-Web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('dist/index.html', 'dist/404.html')\"",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.0.0",
    "typescript": "~6.0.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.0.0",
    "gh-pages": "^6.3.0"
  }
}
